# --- database -----------------------------------------------------------
# Any Postgres. docker-compose.yml brings one up on this URL.
DATABASE_URL=postgres://agenticjobs:agenticjobs@localhost:5432/agenticjobs

# --- this instance ------------------------------------------------------
PORT=8787
# Interface to bind. `::` accepts IPv6 and IPv4-mapped addresses alike, which
# is what you want when a hostname resolves to both.
HOST=0.0.0.0
# The public origin this instance is reachable at. Used for magic links,
# passkeys, JSON-LD, feeds and the entry it announces to the directory, so a
# wrong value here is visible everywhere at once.
PUBLIC_URL=http://localhost:8787
BOARD_NAME=Agentic Jobs
BOARD_TAGLINE=Jobs posted here, not scraped from somewhere else.
# Comma separated. Purely descriptive, and how the directory groups instances.
BOARD_TOPICS=agentic,ai,engineering


# --- federation ---------------------------------------------------------
# Announce this instance to a directory so other people can find it. Empty
# means stay private: nothing is sent anywhere.
DIRECTORY_URL=https://agenticjobs.work
ANNOUNCE=false

# Set to true to BE a directory as well as a board (agenticjobs.work does).
DIRECTORY=false

# --- email --------------------------------------------------------------
# Sign-in links, sent through Resend (https://resend.com). Unset prints them
# to the server log instead of sending, which is what you want on a laptop.
RESEND_API_KEY=
# The From: address. It must be on a domain verified in your Resend account or
# every send is refused. Defaults to jobs@<your PUBLIC_URL host>.
MAIL_FROM=

# --- billing (CoinPay) --------------------------------------------------
# Invoices sent through the inbox settle on CoinPay to the payee's own wallet.
# Leave all of these unset and billing is off. Set all four, or it stays off
# and says so at boot. See "Turning billing on" in the README.
#
# An OAuth client, so people can connect their CoinPay account (wallet:read):
#   coinpay oauth create --name <board> --scope openid,profile,email,wallet:read \
#     --redirect-uri <PUBLIC_URL>/api/v1/coinpay/callback
COINPAY_CLIENT_ID=
COINPAY_CLIENT_SECRET=
# A business of the board's own, which mints the payments payers settle:
#   coinpay business create --name <board> --category marketplace \
#     --webhook-url <PUBLIC_URL>/api/v1/coinpay/webhook
COINPAY_API_KEY=
COINPAY_BUSINESS_ID=
# Verifies CoinPay's webhooks. Unset, payment is learned by polling only.
COINPAY_WEBHOOK_SECRET=
# COINPAY_URL=https://coinpayportal.com
