# --- database -----------------------------------------------------------
# Any Postgres. docker-compose.yml brings one up on this URL.
DATABASE_URL=postgres://agenticjobs:agenticjobs@localhost:5432/agenticjobs

# --- this instance ------------------------------------------------------
PORT=8787
# The public origin this instance is reachable at. Used for magic links,
# passkeys, JSON-LD, feeds and the entry it announces to the directory, so a
# wrong value here is visible everywhere at once.
PUBLIC_URL=http://localhost:8787
BOARD_NAME=Agentic Jobs
BOARD_TAGLINE=Jobs posted here, not scraped from somewhere else.
# Comma separated. Purely descriptive, and how the directory groups instances.
BOARD_TOPICS=agentic,ai,engineering

# Signs sessions, device codes and magic links. Generate with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# Secrets belong in the platform's env or the vault, never in a committed file.
SECRET=

# --- federation ---------------------------------------------------------
# Announce this instance to a directory so other people can find it. Empty
# means stay private: nothing is sent anywhere.
DIRECTORY_URL=https://agenticjobs.work
ANNOUNCE=false

# Set to true to BE a directory as well as a board (agenticjobs.work does).
DIRECTORY=false

# --- email --------------------------------------------------------------
# Magic links and application notifications. Unset prints them to the log
# instead of sending, which is what you want on a laptop.
SMTP_URL=
MAIL_FROM=jobs@localhost
